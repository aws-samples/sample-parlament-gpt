# Agent runtime configuration (no secrets here). Copy to `.env` for local dev.

# Bedrock model: a model ID or inference-profile ID/ARN. The global cross-region
# inference-profile ID below works from any account with model access enabled.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=eu-central-1
# Optional. Leave unset unless the selected model accepts `temperature`.
# BEDROCK_TEMPERATURE=0.0

# DIP API
DIP_BASE_URL=https://search.dip.bundestag.de/api/v1
DIP_TIMEOUT_S=20

# Guardrail (set by CDK outputs after deploy)
GUARDRAIL_ID=
# Leave empty to disable model-side Guardrail attachment.
GUARDRAIL_VERSION=

# Secret containing the DIP API key, as {"apiKey": "..."} (set by CDK outputs).
DIP_API_KEY_SECRET_ARN=

# LOCAL DEV ONLY: provide the key directly instead of Secrets Manager. Never commit a real key.
# DIP_API_KEY=
