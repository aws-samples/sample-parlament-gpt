# Frontend runtime config (no secrets in git). Copy to `.env.local` for dev.
AWS_REGION=eu-central-1
# ARN of the deployed AgentCore runtime (set from CDK output after deploy).
AGENT_RUNTIME_ARN=

# --- Cognito (values from the frontend stack outputs) ---
# Issuer: https://cognito-idp.<region>.amazonaws.com/<userPoolId>
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
# Never commit the client secret; for local dev put it in .env.local only.
COGNITO_CLIENT_SECRET=
# Hosted UI domain, e.g. https://parlamentgpt-<suffix>.auth.<region>.amazoncognito.com
COGNITO_DOMAIN=

# --- Chat persistence ---
# DynamoDB table for sessions + settings (stack output SessionsTableName).
# Unset = persistence features off (chat still works, nothing is stored).
SESSIONS_TABLE=
